# ============================
# Tiki Scraper Configuration
# ============================

# Debug Mode: aktifkan untuk menyimpan screenshot & HTML ke folder debug/
# true = debug aktif, false = debug nonaktif
DEBUG=true

# Browser Headless Mode
# true = tanpa tampilan browser, false = tampilkan browser
API_KEY=tiki-secret-key-123
HEADLESS=true

# Server (port internal, dipakai cloudflared via http://tiki-scraper:8000)
HOST=0.0.0.0
PORT=8000
